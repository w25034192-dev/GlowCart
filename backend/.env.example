APP_NAME=GlowCart API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL (production/local Postgres) or SQLite (local fallback tests)
DATABASE_URL=postgresql+psycopg://glowcart_user:change_me_strong_password@localhost:5432/glowcart

# Security & JWT
JWT_SECRET_KEY=replace_with_64_char_cryptographic_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payment Sandbox
PAYMENT_WEBHOOK_SECRET=replace_with_sandbox_webhook_hmac_secret

# Media Storage (Cloudinary optional; falls back to local /uploads if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAYMENT_PER_MINUTE=30

